@model BE4_LUUTHANHQUAN.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA DANH MỤC</h2>
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@if (ViewBag.HasProducts == true) { <div class="alert alert-warning">Danh mục này đang có sản phẩm nên không thể xóa.</div> }

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4 class="bg-danger">Bạn thực sự muốn xóa danh mục này</h4>
        <hr />

        <div class="form-group">
            <div class="control-label col-md-2">Tên danh mục</div>
            <div class="col-md-10">
                @* Dùng display: inline-block và width: auto để khung dài ngang bằng phần chữ *@
                <div class="form-control" style="background-color: #eee; cursor: not-allowed; display: inline-block; width: auto; min-width: 250px;">
                    @Html.DisplayFor(model => model.CategoryName)
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                @if (ViewBag.HasProducts != true) { <input type="submit" value="Xóa" class="btn btn-primary" /> }
                
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
}