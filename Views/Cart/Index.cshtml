@model IList<BE4_LUUTHANHQUAN.Models.ViewModel.CartItemVM>
@using System.Linq
@{
    ViewBag.Title = "Giỏ hàng";
    var total = Model == null ? 0 : Model.Sum(x => x.Subtotal);
}
<div class="container my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-2">Giỏ hàng của bạn</h2>
        <span class="badge bg-primary fs-6">@(Model == null ? 0 : Model.Count) sản phẩm</span>
    </div>
    @if (TempData["Message"] != null) {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (Model == null || !Model.Any()) {
        <div class="text-center bg-white border rounded-3 shadow-sm p-5">
            <h4>Giỏ hàng đang trống</h4>
            <p class="text-muted">Hãy khám phá và chọn sản phẩm bạn yêu thích nhé!</p>
            @Html.ActionLink("Tiếp tục mua sắm", "Index", "Home", null, new { @class = "btn btn-primary" })
        </div>
    }
    else {
        <div class="table-responsive bg-white rounded-3 shadow-sm">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr><th>Sản phẩm</th><th class="text-end">Đơn giá</th><th class="text-center">Số lượng</th><th class="text-end">Thành tiền</th><th class="text-center">Thao tác</th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td class="fw-semibold">@item.ProductName</td>
                        <td class="text-end text-nowrap">@item.UnitPrice.ToString("N0") đ</td>
                        <td>
                            @using (Html.BeginForm("Update", "Cart", FormMethod.Post, new { @class = "d-flex gap-2 justify-content-center" })) {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", item.ProductID)
                                <input type="number" name="quantity" min="1" max="99" required value="@item.Quantity" class="form-control" style="width:82px" aria-label="Số lượng" />
                                <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap">Cập nhật</button>
                            }
                        </td>
                        <td class="text-end text-danger fw-bold text-nowrap">@item.Subtotal.ToString("N0") đ</td>
                        <td class="text-center">
                            @using (Html.BeginForm("Remove", "Cart", FormMethod.Post, new { @class = "d-inline" })) {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", item.ProductID)
                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?');">Xóa</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="row align-items-center mt-4">
            <div class="col-md-6 mb-3">
                @Html.ActionLink("← Tiếp tục mua sắm", "Index", "Home", null, new { @class = "btn btn-outline-secondary" })
            </div>
            <div class="col-md-6 text-md-end">
                <h4 class="mb-3">Tổng cộng: <span class="text-danger fw-bold">@total.ToString("N0") đ</span></h4>
                @Html.ActionLink("Tiến hành đặt hàng", "Checkout", "Cart", null, new { @class = "btn btn-primary btn-lg" })
            </div>
        </div>
    }
</div>
