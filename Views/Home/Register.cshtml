@model BE4_LUUTHANHQUAN.Models.ViewModel.RegisterVM
@{
    ViewBag.Title = "Đăng ký tài khoản";
}
<div class="container py-4">
    <div class="card border-0 shadow-sm mx-auto" style="max-width:720px;border-radius:14px;">
        <div class="card-body p-4 p-md-5">
            <h2 class="text-center fw-bold mb-2">Tạo tài khoản BE4</h2>
            <p class="text-center text-muted mb-4">Điền thông tin bên dưới để đăng ký</p>
            @using (Html.BeginForm("Register", "Account", FormMethod.Post)) {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Username, "Tên đăng nhập", new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username", placeholder = "Tên đăng nhập" })
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.CustomerName, "Họ và tên", new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", placeholder = "Họ và tên" })
                        @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Password, "Mật khẩu", new { @class = "form-label fw-semibold" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password", placeholder = "Mật khẩu" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ConfirmPassword, "Xác nhận mật khẩu", new { @class = "form-label fw-semibold" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password", placeholder = "Nhập lại mật khẩu" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.CustomerPhone, "Số điện thoại", new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", type = "tel", placeholder = "Số điện thoại" })
                        @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.CustomerEmail, "Email", new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", type = "email", placeholder = "Email" })
                        @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.CustomerAddress, "Địa chỉ giao hàng", new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(m => m.CustomerAddress, new { @class = "form-control", rows = 3, placeholder = "Số nhà, đường, phường/xã, tỉnh/thành phố" })
                        @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary btn-lg w-100">Đăng ký tài khoản</button>
                    </div>
                </div>
            }
            <p class="text-center mt-4 mb-0">Đã có tài khoản? @Html.ActionLink("Đăng nhập", "Login", "Account")</p>
        </div>
    </div>
</div>
